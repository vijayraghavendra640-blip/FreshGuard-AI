# --- Live web evidence (Tavily) ---
TAVILY_API_KEY=tvly-your-key

# --- Model provider key, used by the local Bifrost gateway (scripts/run_bifrost.py) ---
# GROQ_API_KEY is preferred; LLM_API_KEY is accepted for backwards compatibility.
GROQ_API_KEY=gsk_your-key

# --- Bifrost AI gateway (all FreshGuard LLM calls go through it) ---
BIFROST_BASE_URL=http://127.0.0.1:8080/v1
# Optional Bifrost virtual key if governance is enabled on your gateway.
BIFROST_API_KEY=
BIFROST_PRIMARY_MODEL=groq/openai/gpt-oss-120b
BIFROST_FALLBACK_MODELS=groq/qwen/qwen3.8-27b,groq/openai/gpt-oss-20b
# The hallucination auditor deliberately uses a different model family than the verifier.
BIFROST_AUDITOR_MODEL=groq/qwen/qwen3.8-27b
BIFROST_AUDITOR_FALLBACKS=groq/openai/gpt-oss-20b,groq/openai/gpt-oss-120b
BIFROST_REASONING_EFFORT=low

# --- Limits ---
MAX_CLAIMS=12
MAX_VERIFICATION_ATTEMPTS=3
CLAIM_CONCURRENCY=3
LLM_CONCURRENCY=3
RATE_LIMIT_PER_MINUTE=30

# --- Optional protection ---
# Required header X-Admin-Token for POST /api/cache/clear (disabled when empty).
ADMIN_API_TOKEN=
# Required header X-API-Key for POST /api/guardrail (open when empty).
GUARDRAIL_API_KEY=
ALLOWED_ORIGINS=http://localhost:8005,http://127.0.0.1:8005,http://localhost:5173
