{
  "$schema": "https://www.getbifrost.ai/schema",
  "providers": {
    "groq": {
      "keys": [
        {
          "name": "groq-primary",
          "value": "env.GROQ_API_KEY",
          "models": [
            "openai/gpt-oss-120b",
            "openai/gpt-oss-20b",
            "qwen/qwen3.8-27b"
          ],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 45,
        "max_retries": 2,
        "retry_backoff_initial_ms": 500,
        "retry_backoff_max_ms": 4000
      }
    }
  },
  "config_store": {
    "enabled": false
  }
}
